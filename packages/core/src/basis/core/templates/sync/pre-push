#!/bin/sh
# This file is managed by basis: `basis sync` rewrites it from the installed version, and `basis check` fails when it differs.
# The push hook: `basis check --full` on each commit being pushed, so what reaches the remote has passed it, whatever
# was committed with --no-verify: `basis check`, then `regress` where the run store is reachable, and the QA tier
# where the repo declares one and this machine has its settings. It records what it found for `basis review`. A commit
# that is HEAD, in a clean working tree, is checked in place; any other, in a temporary worktree of that commit beside
# the clone, removed after, reading the files git does not track, such as the QA settings, from the clone's own
# folder: at the clone's depth, a path the lockfile gives relative to the repo, such as a checkout of basis, holds
# there too. Never skip it with `git push --no-verify`: fix what each ERROR line says, and push again.
set -eu
cd "$(dirname "$0")/.."

fail() {
    printf 'ERROR: %s\n' "$1" >&2
    exit 1
}

command -v uv >/dev/null 2>&1 || fail "uv is not on the PATH git runs hooks with, and the hooks run every check through it: install uv, as https://docs.astral.sh/uv/ says, or put its folder on the PATH"

tree=""
cleanup() {
    if [ -n "$tree" ]; then
        git worktree remove --force "$tree" </dev/null >/dev/null 2>&1 || rm -rf "$tree"
        git worktree prune </dev/null
        tree=""
    fi
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

head=$(git rev-parse --verify --quiet HEAD || :)
top=$(git rev-parse --show-toplevel)
prefix=$(git rev-parse --show-prefix) # the repo's folder in its clone, empty at the top
refs=$(cat) # each line: LOCAL_REF LOCAL_COMMIT REMOTE_REF REMOTE_COMMIT
checked=" "
failed=0
records="$(git rev-parse --path-format=absolute --git-common-dir)/basis/checks/$prefix"
while read -r ref commit _ _; do
    case "$commit" in
        *[!0]*) ;;
        *) continue ;; # a deletion, which pushes no commit
    esac
    commit=$(git rev-parse --verify --quiet "$commit^{commit}" </dev/null || printf '%s' "$commit") # a tag's commit
    case "$checked" in *" $commit "*) continue ;; esac
    case "$ref" in
        refs/tags/*)
            if grep -q '"passed": true' "$records$commit.json" 2>/dev/null; then
                printf 'basis: %s names commit %s, which basis check --full passed already\n' "${ref#refs/tags/}" "$commit" >&2
                checked="$checked$commit "
                continue
            fi
            ;;
    esac
    checked="$checked$commit "
    if [ "$commit" = "$head" ] && [ -z "$(git status --porcelain </dev/null)" ]; then
        uv run --frozen --quiet basis check --full </dev/null || failed=1
    else
        printf 'basis: checking %s, as it is pushed, in a temporary worktree\n' "$commit" >&2
        tree=$(mktemp -d "$(dirname "$top")/.$(basename "$top").push.XXXXXX")
        git worktree add --quiet --detach "$tree" "$commit" </dev/null
        (cd "$tree/$prefix" && unset VIRTUAL_ENV && uv run --frozen --quiet basis check --full --settings-from "$top/$prefix") </dev/null || failed=1
        cleanup
    fi
done <<EOF
$refs
EOF
[ "$failed" = 0 ] || fail "a commit being pushed fails basis check --full, as above: fix it, commit, and push again"
