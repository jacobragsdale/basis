# The names this repo's app reads. Each environment's values go in your own file for it, which every repo you work in
# shares: ~/.config/basis/dev.env, qa.env and prod.env (%APPDATA%\basis\ENV.env on Windows), which a command reads, alone,
# when it names the environment, as `basis dev --env dev`, each value as written. Each file says which environment it
# is, as BASIS_ENV=dev, so a copy of another's is refused. A pod's deployment sets them as its environment, BASIS_ENV
# among them. `basis dev` with no --env needs none of them: it serves the app on its fakes, from fixtures/.
BASIS_ENV=dev

# Each database the app reads, by the name bd.database gives it. The app reads through this login alone, and never
# writes. TIMEOUT_S bounds each statement, MAX_ROWS each query's result; the database's deadline_s in data.py bounds a
# load, its wait for a thread included.
# BASIS_DATABASES__WAREHOUSE__KIND=mssql
# BASIS_DATABASES__WAREHOUSE__CONNECTION_STRING=Server=dwhost.example.com;Database=Warehouse;Authentication=ActiveDirectoryDefault;Encrypt=yes
# BASIS_DATABASES__WAREHOUSE__ISOLATION=read_committed
# BASIS_DATABASES__WAREHOUSE__TIMEOUT_S=30
# BASIS_DATABASES__WAREHOUSE__MAX_ROWS=1000000

# How the app serves. The image serves on BASIS_SERVE__PORT, 8000 unless it is set. Behind the firm's proxy the app
# lives under a path: PREFIX names it, and PREFIX_STRIPPED says whether the proxy strips it before it forwards a request.
# BASIS_SERVE__PREFIX=/apps/{app}/
# BASIS_SERVE__PREFIX_STRIPPED=false

# The most megabytes of datasets the process keeps in its cache, the least recently used evicted first.
# BASIS_CACHE_MB=512

# Where `basis smoke --env ENV` reaches the app after a deploy: its address there, as a browser opens it.
# BASIS_SMOKE__URL=https://qa.example.com/apps/{app}/

# Where spans go: the Datadog Agent's OTLP receiver, in a pod.
# BASIS_TRACES__EXPORTER=otlp
# BASIS_TRACES__ENDPOINT=http://datadog-agent.datadog.svc.cluster.local:4318/v1/traces

# Logs are JSON lines on stderr from the command line, and text from Python; set the format to override either.
# BASIS_LOG_LEVEL=INFO
# BASIS_LOG_FORMAT=json
