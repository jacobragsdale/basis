[project]
name = "{repo}"
version = "0.1.0"
requires-python = ">=3.14"
dependencies = ["basis-api>={version},<{upper}", "basis-job>={version},<{upper}", "pandas>=3.1.1"]  # an API, and the jobs beside it, which build frames with pandas

[project.entry-points."basis.apis"]
{app} = "{package}.service:service"

[project.entry-points."basis.jobs"]

[tool.basis]
parts = ["api", "job"]  # the parts this repo has, whose verbs `basis` offers; basis never infers one from a folder
coverage = 90  # the percentage of the code's lines and branches the unit tests must cover, which `basis check` holds them to

# The QA tier, which the push hook's `basis check --full` runs on a desktop with the user's own qa.env: each job,
# published to QA. It refuses to run unless every database in qa.env, and its store, has a name that contains the
# marker, and writes only the tables listed, ledgers included. `basis docs job/reference` says more.
# [tool.basis.qa]
# marker = "qa"
# stores = ["abfs://runs@qaaccount.dfs.core.windows.net/{repo}"]
# writes = { warehouse = ["daily_positions", "account_activity", "etl.publishes"] }
#
# [tool.basis.qa.job]
# JOB = { params = "jobs/JOB/params/default.json", interval = "2026-11-05..2026-11-06" }

[build-system]
requires = ["uv_build>=0.13.6,<0.14"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = ["{package}", "jobs"]
module-root = ""

{source}
[dependency-groups]
# pytest-cov measures the coverage `basis check` holds the unit tests to, and mutmut tests mutants in `basis check
# --full`, which needs fork: WSL or Linux.
dev = ["hypothesis>=6.170.0", "mutmut>=3.8.1; sys_platform == 'linux'", "pytest>=9.2.0", "pytest-cov>=7.1.0", "ruff==0.17.4", "schemathesis>=4.33.1", "ty==0.0.99"]

[tool.ruff]
line-length = 200
required-version = ">=0.17.4"
force-exclude = true
show-fixes = true
unsafe-fixes = false

[tool.ruff.lint]
select = ["ALL"]  # Every stable rule; preview rules stay off. Upgrades are deliberate because the version is pinned.
ignore = [
    "COM812",  # Conflicts with the formatter.
    "ISC001",  # Conflicts with the formatter.
    "S603",  # Flags every subprocess call; there is no fix, only review.
    "TC001",  # Moving imports under TYPE_CHECKING breaks code that reads annotations at runtime.
    "TC002",
    "TC003",
    "CPY001",  # A copyright header is a legal decision per repository, not a lint fix.
    "D",  # Write a docstring only where it says what code and types cannot.
]

[tool.ruff.lint.per-file-ignores]
"**/tests/**" = ["S101", "PLR2004", "DTZ001"]  # pytest's assert; literal expectations; a naive datetime is a database's value, in its column's zone
"**/job.py" = ["ARG001"]  # a job's hooks share their signatures, so a hook may leave an argument unused

[tool.ruff.lint.isort]
split-on-trailing-comma = false

[tool.ruff.format]
docstring-code-format = true
skip-magic-trailing-comma = true

[tool.ty.rules]
all = "error"

[tool.ty.analysis]
respect-type-ignore-comments = false
strict-generic-narrowing = true
strict-equality-semantics = true

[tool.ty.terminal]
error-on-warning = true

[tool.pytest.ini_options]
addopts = "-ra --strict-markers --strict-config --import-mode=importlib -m 'not integration'"
testpaths = ["tests", "{package}", "jobs"]
xfail_strict = true
filterwarnings = ["error"]
markers = ["integration: needs a real database; excluded from the default run"]
