# The names this repo's jobs read. Each environment's values go in your own file for it, which every repo you work in
# shares: ~/.config/basis/dev.env, qa.env and prod.env (%APPDATA%\basis\ENV.env on Windows), which a command reads, alone,
# when it names the environment, as `basis run JOB --env dev`. A pod's deployment sets them as its environment,
# BASIS_ENV among them. The QA tier reads qa.env: every database there, and its snapshot root, must have a name that
# contains the QA marker.

# Where `basis run` saves its snapshots, and where a replay finds a run: a path, or a URL such as
# abfs://runs@account.dfs.core.windows.net/etl. A run from Python saves in this repo's snapshots/ instead.
BASIS_SNAPSHOT_ROOT=snapshots

# Each database a job names, by that name. A database is read only once its whole block is set; one without a
# WRITE block is never written. TIMEOUT_S bounds each statement, MAX_ROWS each query's result.

# SQL Server. ISOLATION: snapshot (every query of a run sees one moment; the database must allow it) or read_committed.
# BASIS_DATABASES__SOURCE__KIND=mssql
# BASIS_DATABASES__SOURCE__CONNECTION_STRING=Server=sqlhost.example.com;Database=Trading;Authentication=ActiveDirectoryDefault;Encrypt=yes
# BASIS_DATABASES__SOURCE__ISOLATION=snapshot
# BASIS_DATABASES__SOURCE__TIMEOUT_S=300
# BASIS_DATABASES__SOURCE__MAX_ROWS=5000000

# A database a job writes: its WRITE block is a login that may insert, update and delete in the job's tables and in
# the ledger, which `basis ddl --ledger TABLE --dialect mssql` creates once per database.
# BASIS_DATABASES__WAREHOUSE__KIND=mssql
# BASIS_DATABASES__WAREHOUSE__CONNECTION_STRING=Server=dwhost.example.com;Database=Warehouse;Authentication=ActiveDirectoryDefault;Encrypt=yes
# BASIS_DATABASES__WAREHOUSE__ISOLATION=read_committed
# BASIS_DATABASES__WAREHOUSE__TIMEOUT_S=300
# BASIS_DATABASES__WAREHOUSE__MAX_ROWS=5000000
# BASIS_DATABASES__WAREHOUSE__WRITE__CONNECTION_STRING=Server=dwhost.example.com;Database=Warehouse;UID=etl_writer;PWD=change-me;Encrypt=yes
# BASIS_DATABASES__WAREHOUSE__WRITE__LEDGER=etl.publishes

# Oracle. MODE: thin needs no client libraries; thick loads Oracle Instant Client. ISOLATION: read_only (every query
# of a run sees one moment; fails on a table truncated or altered seconds before) or read_committed.
# BASIS_DATABASES__MARKETS__KIND=oracle
# BASIS_DATABASES__MARKETS__DSN=orahost.example.com:1521/MARKETS
# BASIS_DATABASES__MARKETS__USER=etl_reader
# BASIS_DATABASES__MARKETS__PASSWORD=change-me
# BASIS_DATABASES__MARKETS__MODE=thin
# BASIS_DATABASES__MARKETS__ISOLATION=read_only
# BASIS_DATABASES__MARKETS__TIMEOUT_S=300
# BASIS_DATABASES__MARKETS__MAX_ROWS=5000000
# BASIS_DATABASES__MARKETS__WRITE__USER=etl_writer
# BASIS_DATABASES__MARKETS__WRITE__PASSWORD=change-me
# BASIS_DATABASES__MARKETS__WRITE__LEDGER=ETL.PUBLISHES

# A Mongo database, by the name its etl.Mongo or etl.MongoUpsert gives: its connection string, a secret, the database,
# the seconds each read or upsert may take, and the most documents a read may return.
# BASIS_MONGO__REFERENCE__URI=mongodb://etl:change-me@mongohost.example.com:27017/?replicaSet=rs0
# BASIS_MONGO__REFERENCE__DATABASE=reference
# BASIS_MONGO__REFERENCE__TIMEOUT_S=60
# BASIS_MONGO__REFERENCE__MAX_DOCUMENTS=1000000

# A shared folder a job reads or writes workbooks in, by the name its etl.Excel or etl.ExcelReport gives, as this
# machine reaches it: \\server\share\pm on Windows, its mount path in WSL and in a pod.
# BASIS_FOLDERS__PM__PATH=/mnt/pm

# A Slack channel a message posts to, by the name its etl.Slack gives, through its incoming webhook, a secret.
# BASIS_SLACK__DESK__WEBHOOK=https://hooks.slack.com/services/T000/B000/change-me

# People an email goes to, by the name its etl.Email gives, and the relay it goes through: SECURITY is none, starttls
# or tls; USER and PASSWORD only where the relay asks for a login.
# BASIS_EMAIL__RISK__HOST=smtp.example.com
# BASIS_EMAIL__RISK__PORT=25
# BASIS_EMAIL__RISK__SECURITY=none
# BASIS_EMAIL__RISK__SENDER=etl@example.com
# BASIS_EMAIL__RISK__TO=["risk@example.com"]

# A deployment whose vault limits a secret's name, as berth's 40 characters do, can give a database's secret parts as
# one JSON value at the database's own name, which merges with its other variables:
# BASIS_DATABASES__WAREHOUSE={"connection_string": "...", "write": {"connection_string": "...", "ledger": "etl.publishes"}}

# Logs are JSON lines on stderr from the command line, and text from Python; set the format to override either.
# BASIS_LOG_LEVEL=INFO
# BASIS_LOG_FORMAT=json
