# Copy to .env (and .env.qa, .env.prod) and fill in what this machine reads. A job's main.py names the file it reads;
# the command line reads the process's environment: `uv run --env-file .env etl run ...`.

# Where `etl run` saves its snapshots, and where a replay finds a run: a path, or a URL such as
# abfs://runs@account.dfs.core.windows.net/etl. A run from Python saves in this repo's snapshots/ instead.
ETL_SNAPSHOT_ROOT=snapshots

# Each database a job names, by that name. A database is read only once its whole block is set; one without a
# WRITE block is never written. TIMEOUT_S bounds each statement, MAX_ROWS each query's result.

# SQL Server. ISOLATION: snapshot (every query of a run sees one moment; the database must allow it) or read_committed.
# ETL_DATABASES__SOURCE__KIND=mssql
# ETL_DATABASES__SOURCE__CONNECTION_STRING=Server=sqlhost.example.com;Database=Trading;Authentication=ActiveDirectoryDefault;Encrypt=yes
# ETL_DATABASES__SOURCE__ISOLATION=snapshot
# ETL_DATABASES__SOURCE__TIMEOUT_S=300
# ETL_DATABASES__SOURCE__MAX_ROWS=5000000

# A database a job writes: its WRITE block is a login that may insert, update and delete in the job's tables and in
# the ledger, which `etl ddl --ledger TABLE --dialect mssql` creates once per database.
# ETL_DATABASES__WAREHOUSE__KIND=mssql
# ETL_DATABASES__WAREHOUSE__CONNECTION_STRING=Server=dwhost.example.com;Database=Warehouse;Authentication=ActiveDirectoryDefault;Encrypt=yes
# ETL_DATABASES__WAREHOUSE__ISOLATION=read_committed
# ETL_DATABASES__WAREHOUSE__TIMEOUT_S=300
# ETL_DATABASES__WAREHOUSE__MAX_ROWS=5000000
# ETL_DATABASES__WAREHOUSE__WRITE__CONNECTION_STRING=Server=dwhost.example.com;Database=Warehouse;UID=etl_writer;PWD=change-me;Encrypt=yes
# ETL_DATABASES__WAREHOUSE__WRITE__LEDGER=etl.publishes

# Oracle. MODE: thin needs no client libraries; thick loads Oracle Instant Client. ISOLATION: read_only (every query
# of a run sees one moment; fails on a table truncated or altered seconds before) or read_committed.
# ETL_DATABASES__MARKETS__KIND=oracle
# ETL_DATABASES__MARKETS__DSN=orahost.example.com:1521/MARKETS
# ETL_DATABASES__MARKETS__USER=etl_reader
# ETL_DATABASES__MARKETS__PASSWORD=change-me
# ETL_DATABASES__MARKETS__MODE=thin
# ETL_DATABASES__MARKETS__ISOLATION=read_only
# ETL_DATABASES__MARKETS__TIMEOUT_S=300
# ETL_DATABASES__MARKETS__MAX_ROWS=5000000
# ETL_DATABASES__MARKETS__WRITE__USER=etl_writer
# ETL_DATABASES__MARKETS__WRITE__PASSWORD=change-me
# ETL_DATABASES__MARKETS__WRITE__LEDGER=ETL.PUBLISHES

# Logs are JSON lines on stderr from the command line, and text from Python; set the format to override either.
# ETL_LOG_LEVEL=INFO
# ETL_LOG_FORMAT=json
