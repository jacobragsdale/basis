[project]
name = "{repo}"
version = "0.1.0"
requires-python = ">=3.14"
dependencies = ["basis-job>={version},<{upper}", "pandas>=3.1.1"]  # jobs build frames with pandas

[project.entry-points."basis.jobs"]
{job} = "jobs.{job}.job"

[tool.basis]
parts = ["job"]  # the parts this repo has, whose verbs `basis` offers; basis never infers one from a folder
coverage = 90  # the percentage of the code's lines and branches the unit tests must cover, which `basis check` holds them to

# The QA tier, which the push hook's `basis check --full` runs on a desktop with the user's own qa.env: each job,
# published to QA. It refuses to run unless every database in qa.env, and its store, has a name that contains the
# marker, and writes only the tables listed, ledgers included. `basis docs job/reference` says more.
# [tool.basis.qa]
# marker = "qa"
# stores = ["abfs://runs@qaaccount.dfs.core.windows.net/{repo}"]
# writes = { warehouse = ["daily_positions", "account_activity", "etl.publishes"] }
#
# [tool.basis.qa.job]
# {job} = { params = "jobs/{job}/params/default.json", interval = "2026-11-05..2026-11-06" }

[build-system]
requires = ["uv_build>=0.13.6,<0.14"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "jobs"
module-root = ""

{source}
[dependency-groups]
# The tools `basis check` runs, at the versions basis checks with, which `basis upgrade` moves with basis: ruff, ty,
# pytest and pytest-cov, and mutmut, which tests mutants in `basis check --full` and needs fork: WSL or Linux. Their
# settings are basis's too, in ruff.toml, ty.toml and pytest.ini, which `basis sync` writes; the repo's own exceptions
# go in [tool.basis] exceptions, each with its reason.
dev = ["basis-job[dev]"]
