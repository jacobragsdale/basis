[project]
name = "{repo}"
version = "0.1.0"
requires-python = ">=3.14"
dependencies = ["basis-job>={version},<0.{next_minor}", "polars>=2.1.0"]  # jobs build frames with polars

[project.entry-points."basis.jobs"]
{job} = "jobs.{job}.job"

[tool.basis]
parts = ["job"]  # the parts this repo has, whose verbs `basis` offers; basis never infers one from a folder

[build-system]
requires = ["uv_build>=0.13.6,<0.14"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "jobs"
module-root = ""

{source}
[dependency-groups]
dev = ["pre-commit>=4.7.0", "pytest>=9.2.0", "ruff==0.17.4", "ty==0.0.99"]

[tool.ruff]
line-length = 200
required-version = ">=0.17.4"
force-exclude = true
show-fixes = true
unsafe-fixes = false

[tool.ruff.lint]
select = ["ALL"]  # Every stable rule; preview rules stay off. Upgrades are deliberate because the version is pinned.
ignore = [
    "COM812",  # Conflicts with the formatter.
    "ISC001",  # Conflicts with the formatter.
    "S603",  # Flags every subprocess call; there is no fix, only review.
    "TC001",  # Moving imports under TYPE_CHECKING breaks code that reads annotations at runtime.
    "TC002",
    "TC003",
    "CPY001",  # A copyright header is a legal decision per repository, not a lint fix.
    "D",  # Write a docstring only where it says what code and types cannot.
]

[tool.ruff.lint.per-file-ignores]
"**/tests/**" = ["S101", "PLR2004", "DTZ001"]  # pytest's assert; literal expectations; a naive datetime is a database's value, in its column's zone
"**/job.py" = ["ARG001"]  # a job's hooks share their signatures, so a hook may leave an argument unused

[tool.ruff.lint.isort]
split-on-trailing-comma = false

[tool.ruff.format]
docstring-code-format = true
skip-magic-trailing-comma = true

[tool.ty.rules]
all = "error"

[tool.ty.analysis]
respect-type-ignore-comments = false
strict-generic-narrowing = true
strict-equality-semantics = true

[tool.ty.terminal]
error-on-warning = true

[tool.pytest.ini_options]
addopts = "-ra --strict-markers --strict-config --import-mode=importlib -m 'not integration'"
testpaths = ["tests", "jobs"]
xfail_strict = true
filterwarnings = ["error"]
markers = ["integration: needs a real database; excluded from the default run"]
