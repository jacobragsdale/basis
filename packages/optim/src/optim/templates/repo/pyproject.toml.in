[project]
name = "{repo}"
version = "0.1.0"
description = "Portfolio models that run on optim"
readme = "README.md"
requires-python = ">=3.14"
dependencies = ["optim>={version},<{upper}"]  # before 1.0 a minor release may break the contract, so a repo takes patches alone; from 1.0, what keeps its major

# Each model by name: its folder's model.py, which `basis run NAME` and a replay find it by.
[project.entry-points."optim.models"]
{model} = "models.{module}.model"

[tool.basis]
parts = ["optim"]  # the parts this repo has, whose verbs `basis` offers; basis never infers one from a folder
coverage = 90  # the percentage of the code's lines and branches the unit tests must cover, which `basis check` holds them to

[build-system]
requires = ["uv_build>=0.13.6,<0.14"]
build-backend = "uv_build"

# The package is `models`, at the repo's root, installed in editable mode, so `from models.MODEL import model` works
# whichever folder a file runs from.
[tool.uv.build-backend]
module-name = "models"
module-root = ""

{source}
[dependency-groups]
# pytest-cov measures the coverage `basis check` holds the unit tests to, and mutmut tests mutants in `basis check
# --full`, which needs fork: WSL or Linux.
dev = [
    "mutmut>=3.8.1; sys_platform == 'linux'",
    "pandas-stubs>=3.0.5.260914",
    "pytest>=9.2.0",
    "pytest-cov>=7.1.0",
    "ruff==0.17.4",
    "scipy-stubs>=1.18.1.1",
    "ty==0.0.99",
]

[tool.ruff]
line-length = 200
required-version = ">=0.17.4"
force-exclude = true

[tool.ruff.lint]
select = ["ALL"]  # every rule, `print` (T20) included, since models log; opt out below, with a reason
ignore = [
    "D",  # module docstrings are prose, not pydocstyle sections
    "CPY",  # no copyright headers
    "COM812",  # conflicts with the formatter
    "TC",  # annotations are lazy on 3.14, and pydantic needs its types at runtime
    "PLR2004",  # 0.05 and friends read better inline than as constants
    "PLR0913",  # keyword-only arguments are clearer than a parameter object
    "FBT003",  # stdlib calls take positional booleans
]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "INP001"]  # pytest asserts; tests/ is not a package
"models/*/tests/**" = ["S101"]  # pytest asserts
"models/*/{model.py,rules/**}" = ["ARG001"]  # hooks and rules share their signatures, so most leave an argument unused

[tool.ruff.lint.isort]
split-on-trailing-comma = false

[tool.ruff.format]
docstring-code-format = true
skip-magic-trailing-comma = true

[tool.ty.rules]
blanket-ignore-comment = "error"
missing-override-decorator = "error"
missing-type-argument = "error"
unsound-return-statement = "error"

[tool.ty.analysis]
respect-type-ignore-comments = false  # a specific `# ty: ignore[rule]`, with a reason

[tool.ty.terminal]
error-on-warning = true

[tool.pytest.ini_options]
addopts = "-ra --strict-markers --strict-config --import-mode=importlib -m 'not e2e'"
testpaths = ["models", "tests"]
xfail_strict = true
filterwarnings = ["error"]
# The e2e suite (`uv run --env-file .env.qa pytest -m e2e`) runs only where every source and destination contains a QA
# marker, and writes only to these: list the QA snapshot root and orders table, exactly as the QA environment sets them.
optim_qa_markers = ["qa"]
optim_e2e_writes = []
