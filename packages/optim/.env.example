# Copy to .env and fill in what this machine reads; run with `uv run --env-file .env basis ...`. Only
# BASIS_SNAPSHOT_ROOT is required: a source left out cannot be read, so a run on files needs nothing else.

# Where `basis run` saves its runs, and where a replay finds a run by its id: a run store at a path, or a URL read
# through pyarrow.fs, such as abfs://container@account.dfs.core.windows.net/runs.
BASIS_SNAPSHOT_ROOT=snapshots
# The dataset cache, a path or URL. Without it every dataset is read live; `basis warm` needs it.
# BASIS_OPTIM__CACHE_ROOT=cache
# Worker processes per run; 1 decides in the calling process.
# BASIS_OPTIM__WORKERS=1

# A database is read only once every line of its block is set, MAX_CONCURRENT included: uncomment the whole block, and
# change its values. A dataset names the database it reads, which names the block: optim's shared holdings read `mssql`,
# and its securities `oracle`. ISOLATION is how a run's reads see the database, and optim reads each batch of portfolios
# at one moment: `snapshot` on SQL Server, `read_only` on Oracle; it refuses `read_committed`, which reads each query at
# its own, for a database it reads. TIMEOUT_S is the seconds each statement may take, the login included, though a login
# never waits more than 30; MAX_ROWS the most rows a query may return; and MAX_CONCURRENT how many reads a run has open
# to the database at once.

# Oracle. `thin` needs no client libraries; `thick` loads Oracle Instant Client, which some databases need.
# `read_only` fails a read of a table whose definition changed seconds before (ORA-01466; a TRUNCATE counts).
# BASIS_DATABASES__ORACLE__KIND=oracle
# BASIS_DATABASES__ORACLE__DSN=dbhost.example.com:1521/ANALYTICS
# BASIS_DATABASES__ORACLE__USER=optim
# BASIS_DATABASES__ORACLE__PASSWORD=change-me
# BASIS_DATABASES__ORACLE__MODE=thin
# BASIS_DATABASES__ORACLE__ISOLATION=read_only
# BASIS_DATABASES__ORACLE__TIMEOUT_S=240
# BASIS_DATABASES__ORACLE__MAX_ROWS=2000000
# BASIS_OPTIM__DATABASES__ORACLE__MAX_CONCURRENT=4
# Thick mode only, and only where Oracle Instant Client is not on the library path:
# BASIS_DATABASES__ORACLE__CLIENT_LIB_DIR=/opt/oracle/instantclient

# SQL Server: the primary, not a readable secondary, since holdings must include the trades just booked. `snapshot`
# isolation needs the database to allow it (ALLOW_SNAPSHOT_ISOLATION ON).
# BASIS_DATABASES__MSSQL__KIND=mssql
# BASIS_DATABASES__MSSQL__CONNECTION_STRING=Server=sqlhost.example.com;Database=Accounts;Authentication=ActiveDirectoryDefault;Encrypt=yes
# BASIS_DATABASES__MSSQL__ISOLATION=snapshot
# BASIS_DATABASES__MSSQL__TIMEOUT_S=240
# BASIS_DATABASES__MSSQL__MAX_ROWS=2000000
# BASIS_OPTIM__DATABASES__MSSQL__MAX_CONCURRENT=4

# A REST API that answers a GET with a list of records, such as the signals API.
# BASIS_OPTIM__REST__URL=https://signals.example.com
# BASIS_OPTIM__REST__MAX_CONCURRENT=2
# BASIS_OPTIM__REST__TIMEOUT_S=240
# BASIS_OPTIM__REST__MAX_ROWS=500000

# Logs are JSON lines on stderr; `text` reads better in a terminal.
# BASIS_LOG_LEVEL=INFO
# BASIS_LOG_FORMAT=json

# Production only: the table `basis run` writes accepted portfolios' orders to, in a database whose block has a write
# login that may insert into it, apart from the login that reads. Without it, orders stay in the run's snapshot.
# BASIS_DATABASES__TRADING__KIND=mssql
# BASIS_DATABASES__TRADING__CONNECTION_STRING=Server=sqlhost.example.com;Database=Trading;Authentication=ActiveDirectoryDefault;Encrypt=yes
# BASIS_DATABASES__TRADING__ISOLATION=read_committed
# BASIS_DATABASES__TRADING__TIMEOUT_S=60
# BASIS_DATABASES__TRADING__MAX_ROWS=1000
# BASIS_DATABASES__TRADING__WRITE__CONNECTION_STRING=Server=sqlhost.example.com;Database=Trading;Authentication=ActiveDirectoryDefault;Encrypt=yes
# BASIS_OPTIM__ORDERS__DATABASE=trading
# BASIS_OPTIM__ORDERS__TABLE=trading.orders
